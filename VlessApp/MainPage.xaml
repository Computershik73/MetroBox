    <Page
    x:Class="VlessApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VlessApp"
    RequestedTheme="Dark">

        <Page.Resources>
            <CollectionViewSource x:Name="GroupedProfilesCVS" IsSourceGrouped="True"/>

            <!-- Кастомный стиль выпадающего меню под стиль Happ -->
            <Style x:Key="AddMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
                <Setter Property="Background" Value="#12182D"/>
                <Setter Property="BorderBrush" Value="#1F264E"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="0,4,0,4"/>
            </Style>

            <!-- Объемный вертикальный градиент для ПОДКЛЮЧЕННОГО состояния -->
            <LinearGradientBrush x:Key="ButtonGlowConnected" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1D4ED8" Offset="0.0"/>
                <GradientStop Color="#1E3A8A" Offset="0.4"/>
                <GradientStop Color="#0F172A" Offset="1.0"/>
            </LinearGradientBrush>

            <!-- Объемный вертикальный градиент для ОТКЛЮЧЕННОГО состояния -->
            <LinearGradientBrush x:Key="ButtonGlowDisconnected" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1E2548" Offset="0.0"/>
                <GradientStop Color="#13172E" Offset="0.5"/>
                <GradientStop Color="#0F1326" Offset="1.0"/>
            </LinearGradientBrush>

            <!-- Шаблон карточки группы серверов (Happ Style) -->
            <Style TargetType="GroupItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                            <Border Background="#12182D" CornerRadius="16" BorderBrush="#1F264E" BorderThickness="1" Margin="16,0,16,16" Padding="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                    <ItemsPresenter Grid.Row="1"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Кастомный стиль круглой неоновой кнопки подключения -->
            <Style x:Key="ConnectButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="Transparent">
                                <Border x:Name="BackgroundBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="75"
                                    Width="150" Height="150"/>

                                <Border Margin="1.5" BorderBrush="#FFFFFF" BorderThickness="1" Opacity="0.12" CornerRadius="73.5" Width="147" Height="147"/>

                                <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Page.Resources>

        <!-- Тёмно-синий градиент подложки -->
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#090D1C" Offset="0.0"/>
                    <GradientStop Color="#12172B" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 0. Верхний бар -->
                <RowDefinition Height="Auto"/>
                <!-- 1. Сфера подключения -->
                <RowDefinition Height="Auto"/>
                <!-- 2. Заголовки-подсказки -->
                <RowDefinition Height="*"/>
                <!-- 3. Список серверов -->
            </Grid.RowDefinitions>

            <!-- ВЕРХНИЙ БАР ДЕЙСТВИЙ (StatusText скрыт для чистейшего соответствия happ) -->
            <Grid Grid.Row="0" Margin="16,10,16,10">
                <Button x:Name="SettingsBtn" Click="SettingsBtn_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="8">
                    <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#9CA3AF"/>
                </Button>
                <TextBlock x:Name="StatusText" Visibility="Collapsed"/>
                <!-- Оставлен в скрытом состоянии для компиляции -->

                <!-- КНОПКА ДОБАВЛЕНИЯ С ВЫПАДАЮЩИМ МЕНЮ (Flyout) -->
                <Button x:Name="AddBtn" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Padding="8">
                    <FontIcon Glyph="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#9CA3AF"/>
                    <Button.Flyout>
                        <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource AddMenuFlyoutPresenterStyle}">
                            <MenuFlyoutItem Text="📋  Добавить из буфера" Click="ImportFromClipboard_Click" Height="44" />
                            <MenuFlyoutItem Text="📷  Сканировать QR-код" Click="ScanQrCode_Click" Height="44" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- ОБЪЕМНАЯ СФЕРА ПОДКЛЮЧЕНИЯ С НЕОНОВЫМИ КОЛЬЦАМИ -->
            <Grid Grid.Row="1" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10">
                <Border x:Name="GlowRing1" Width="220" Height="220" CornerRadius="110" BorderThickness="1" BorderBrush="#2563EB" Opacity="0.1"/>
                <Border x:Name="GlowRing2" Width="190" Height="190" CornerRadius="95" BorderThickness="1.5" BorderBrush="#2563EB" Opacity="0.25"/>

                <Button x:Name="ConnectBtn" Click="ConnectBtn_Click" Width="150" Height="150" Style="{StaticResource ConnectButtonStyle}" Background="{StaticResource ButtonGlowDisconnected}" BorderBrush="#2563EB" BorderThickness="3">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <FontIcon x:Name="PowerIcon" Glyph="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="White" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ConnectBtnText" Text="ПОДКЛЮЧИТЬ" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TimeText" Text="00:00:00" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ВСПОМОГАТЕЛЬНЫЕ ПОДПИСИ -->
            <Grid Grid.Row="2" Margin="24,10,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="CheckConnectionText" Grid.Row="0" Text="Проверить текущее подключение" FontSize="13" Foreground="#9CA3AF" HorizontalAlignment="Left" VerticalAlignment="Center" Tapped="CheckConnection_Tapped" IsTapEnabled="True"/>
                <TextBlock x:Name="HideAllBtn" Grid.Row="0" Text="Скрыть все" FontSize="13" Foreground="#3B82F6" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Tapped="HideAll_Tapped"/>
                <!-- Туннель может стоять поднятым, а сервер при этом отвергать каждое
                     соединение (например 429 от исчерпанного Cloudflare Worker). Тогда
                     кнопка честно горит «ПОДКЛЮЧЕН», и без этой строки причина видна
                     только в файле лога. -->
                <TextBlock x:Name="TransportWarnText" Grid.Row="1" Visibility="Collapsed" FontSize="11" Foreground="#F59E0B" LineHeight="15" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </Grid>

            <!-- СПИСОК СЕРВЕРОВ (ShowsScrollingPlaceholders=False выключает пустые блоки при скролле) -->
            <ListView Grid.Row="3" x:Name="ProfilesList" Margin="0,0,0,0" SelectionMode="None"
                  ShowsScrollingPlaceholders="False"
                  ItemsSource="{Binding Source={StaticResource GroupedProfilesCVS}}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel AreStickyGroupHeadersEnabled="False"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,0,0,0"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <!-- Оформление шапки группы подписки (Оптимизировано через x:Bind) -->
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="local:ProfileGroup">
                                <Grid Margin="16,14,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.ColumnSpan="3" Background="Transparent" Tapped="GroupHeader_Tapped" Tag="{x:Bind}"/>

                                    <FontIcon Grid.Column="0" FontFamily="Segoe MDL2 Assets" Glyph="{x:Bind ArrowIcon, Mode=OneWay}" FontSize="11" Foreground="#3B82F6" VerticalAlignment="Top" Margin="0,4,12,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind LastUpdatedText, Mode=OneWay}" FontSize="10" Foreground="#6B7280" Margin="0,2,0,0"/>
                                        <TextBlock Text="{x:Bind AmneziaInfo, Mode=OneWay}" Visibility="{x:Bind AmneziaInfoVisibility, Mode=OneWay}" FontSize="10" Foreground="#3B82F6" Margin="0,2,0,4"/>

                                        <StackPanel Orientation="Horizontal" Visibility="{x:Bind InfoButtonsVisibility, Mode=OneWay}" Margin="0,0,0,4">
                                            <Border Tapped="InfoLink_Tapped" DataContext="{x:Bind}" Background="#1E293B" CornerRadius="8" Padding="6,3,8,3" Margin="0,0,8,0" IsTapEnabled="True">
                                                <StackPanel Orientation="Horizontal">
                                                    <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#3B82F6" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Инфо" FontSize="10" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Tapped="TelegramLink_Tapped" DataContext="{x:Bind}" Background="#1E293B" CornerRadius="8" Padding="6,3,8,3" IsTapEnabled="True">
                                                <StackPanel Orientation="Horizontal">
                                                    <FontIcon Glyph="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#3B82F6" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Telegram" FontSize="10" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{x:Bind Description, Mode=OneWay}" Visibility="{x:Bind DescriptionVisibility, Mode=OneWay}" FontSize="11" Foreground="#9CA3AF" LineHeight="16" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                                        <Button Background="Transparent" BorderThickness="0" Padding="6" Margin="0,0,2,0" Click="UpdateSubscription_Click" DataContext="{x:Bind}">
                                            <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#9CA3AF"/>
                                        </Button>
                                        <Button Background="Transparent" BorderThickness="0" Padding="6" Margin="0,0,2,0" Click="PingGroup_Click" DataContext="{x:Bind}">
                                            <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#9CA3AF"/>
                                        </Button>
                                        <Button Background="Transparent" BorderThickness="0" Padding="6" Margin="0,0,2,0" Click="RenameSubscription_Click" DataContext="{x:Bind}">
                                            <FontIcon Glyph="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#9CA3AF"/>
                                        </Button>
                                        <Button Background="Transparent" BorderThickness="0" Padding="6" Click="DeleteSubscription_Click" DataContext="{x:Bind}">
                                            <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#9CA3AF"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>

                <!-- Шаблон ячейки сервера (Полностью переведен на x:Bind для мгновенного рендеринга при скролле) -->
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:VlessProfile">
                        <Border BorderBrush="#1F264E" BorderThickness="0,0,0,0.5">
                            <Grid Background="#12182D" ManipulationMode="TranslateX,System" ManipulationDelta="Item_ManipulationDelta" ManipulationCompleted="Item_ManipulationCompleted">

                                <!-- Левая панель действий (Ping / Share) -->
                                <Grid Width="120" Height="56" HorizontalAlignment="Left" Background="#1D2447">
                                    <StackPanel Orientation="Horizontal" Visibility="{x:Bind DefaultActionsVisibility, Mode=OneWay}">
                                        <Button Width="60" Height="56" Background="#10B981" BorderThickness="0" Padding="0" Click="SwipePing_Click" Tag="{x:Bind}">
                                            <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button Width="60" Height="56" Background="#6366F1" BorderThickness="0" Padding="0" Click="SwipeShare_Click" Tag="{x:Bind}">
                                            <FontIcon Glyph="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>

                                    <Grid Visibility="{x:Bind SharePanelVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Width="40" Height="56" Click="ShareUrl_Click" Background="#4F46E5" BorderThickness="0" Padding="0">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White"/>
                                                <TextBlock Text="URL" FontSize="8" Foreground="White" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Width="40" Height="56" Click="ShareQr_Click" Background="#4F46E5" BorderThickness="1,0,1,0" BorderBrush="#1F264E" Padding="0">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White"/>
                                                <TextBlock Text="QR" FontSize="8" Foreground="White" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" Width="40" Height="56" Click="ShareJson_Click" Background="#4F46E5" BorderThickness="0" Padding="0">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White"/>
                                                <TextBlock Text="JSON" FontSize="8" Foreground="White" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>

                                <!-- ПРАВАЯ ПАНЕЛЬ ДЕЙСТВИЙ: Кнопка удаления -->
                                <Grid Width="60" Height="56" HorizontalAlignment="Right" Background="#EF4444" Tapped="SwipeDelete_Click" Tag="{x:Bind}" IsTapEnabled="True">
                                    <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Верхний слой: Сам элемент сервера -->
                                <Grid x:Name="ContentGrid" Background="{x:Bind ItemBackgroundBrush, Mode=OneWay}" Tapped="Item_Tapped" IsTapEnabled="True" Loaded="ContentGrid_Loaded">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="Translation"/>
                                    </Grid.RenderTransform>

                                    <Border Width="4" Background="White" HorizontalAlignment="Left" VerticalAlignment="Stretch" Visibility="{x:Bind SelectedIndicatorVisibility, Mode=OneWay}"/>

                                    <Grid Padding="16,10,16,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Флаг страны: скруглённый прямоугольник во всю плитку.
                                             Рисуется в CountryFlags попиксельно — эмодзи-флаги
                                             Windows показывает буквенным квадратиком, а не флагом. -->
                                        <Grid Grid.Column="0" Width="40" Height="28" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <Border CornerRadius="5" BorderBrush="#2AFFFFFF" BorderThickness="1"
                                                    Visibility="{x:Bind FlagVisibility, Mode=OneWay}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{x:Bind FlagImage, Mode=OneWay}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>

                                            <!-- Страна известна, но флага в наборе нет -->
                                            <Border CornerRadius="5" Background="#1D2447"
                                                    Visibility="{x:Bind CodeBadgeVisibility, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind CountryBadgeText, Mode=OneWay}"
                                                           FontSize="13" FontWeight="Bold" Foreground="#3B82F6"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Страна не определилась -->
                                            <Border CornerRadius="5" Background="#1D2447"
                                                    Visibility="{x:Bind GlobeVisibility, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE12B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                          Foreground="#3B82F6" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        </StackPanel>

                                        <!-- Правая колонка: Вывод пинга и шеврон -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind CleanPingText, Mode=OneWay}" FontSize="12" Foreground="{x:Bind PingBrush, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <FontIcon Glyph="&#xE00F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#4B5563" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- СТРАНИЦА «О ПРИЛОЖЕНИИ» -->
            <Grid x:Name="AboutPageGrid" Grid.RowSpan="4" Visibility="Collapsed" Canvas.ZIndex="100">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#090D1C" Offset="0.0"/>
                        <GradientStop Color="#12172B" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка страницы -->
                <Grid Grid.Row="0" Margin="16,10,16,10">
                    <Button x:Name="AboutBackBtn" Click="AboutBackBtn_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="8">
                        <FontIcon Glyph="&#xE112;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#3B82F6"/>
                    </Button>
                    <TextBlock Text="О приложении" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Контентная карточка -->
                <ScrollViewer Grid.Row="1" Margin="16,10,16,16">
                    <Border Background="#12182D" CornerRadius="16" BorderBrush="#1F264E" BorderThickness="1" Padding="20">
                        <StackPanel>
                            <!-- Название приложения (MetroBox) -->
                            <TextBlock Text="MetroBox" FontSize="28" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                            <TextBlock Text="Версия 1.3.6" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,20"/>

                            <!-- Описание -->
                            <TextBlock Text="Современный клиент VLESS VPN для устройств под управлением Windows 10 Mobile." 
                                   FontSize="14" Foreground="#E2E8F0" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,24"/>

                            <!-- Раздел ссылок -->
                            <TextBlock Text="Связь и поддержка:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

                            <!-- Telegram-канал -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="• " FontSize="14" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <HyperlinkButton Content="Telegram канал" NavigateUri="https://t.me/cmplog" Foreground="#3B82F6" Padding="0" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>

                            <!-- Профиль на 4PDA -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="• " FontSize="14" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <HyperlinkButton Content="Профиль на 4PDA" NavigateUri="https://4pda.to/forum/index.php?showuser=4458524" Foreground="#3B82F6" Padding="0" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>

                            <!-- Поддержать проект -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="• " FontSize="14" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <HyperlinkButton Content="Поддержать проект" NavigateUri="https://pay.cloudtips.ru/p/83821e32" Foreground="#3B82F6" Padding="0" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>

                            <!-- Отправка журналов: без них разбирать «не подключается» нечем -->
                            <TextBlock Text="Диагностика:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,14,0,8"/>
                            <TextBlock Text="Журнал очищается при каждом запуске приложения. Если сервер не подключается — повторите попытку, затем отправьте журнал."
                                       FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,10"/>
                            <Button x:Name="ShareLogBtn" Click="ShareLogBtn_Click" HorizontalAlignment="Stretch"
                                    Background="#1D2447" BorderBrush="#2A3566" BorderThickness="1" Padding="12,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                    <TextBlock Text="Отправить журнал" Foreground="#E2E8F0" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="ShareLogHint" Text="" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Page>